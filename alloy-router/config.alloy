otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
    max_recv_msg_size = "200MiB"
  }

  output {
    traces = [
      otelcol.exporter.loadbalancing.tail_sampling.input,
      otelcol.exporter.loadbalancing.span_metrics.input,
    ]
  }
}

otelcol.exporter.loadbalancing "tail_sampling" {
  routing_key = "traceID"
  protocol { 
    otlp { 
      client {
        tls { 
          insecure = true 
        } 
      }
    } 
  }
  resolver {
    dns {
      hostname = "alloy-tail-sampling"
      port = 4317
    }
  }
}

otelcol.exporter.loadbalancing "span_metrics" {
  routing_key = "traceID"
  protocol { 
    otlp { 
      client {
        tls { 
          insecure = true 
        } 
      }
    } 
  }
  resolver {
    dns {
      hostname = "alloy-span-metrics"
      port = 4317
    }
  }
}

loki.source.api "default" {
  http {
    listen_address = "0.0.0.0"
    listen_port = 3100
  }
  forward_to = [loki.write.grafana.receiver]
}

loki.write "grafana" {
  endpoint {
    url = "http://alloy-grafana:3100/loki/api/v1/push"
  }
}
