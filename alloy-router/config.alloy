otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
    max_recv_msg_size = "200MiB"
  }

  output {
    traces = [
      otelcol.exporter.loadbalancing.tail_sampling.input,
      otelcol.exporter.loadbalancing.span_metrics.input,
    ]
    logs = [otelcol.exporter.loadbalancing.grafana.input]
  }
}

otelcol.exporter.loadbalancing "tail_sampling" {
  routing_key = "traceID"
  protocol { otlp { tls { insecure = true } } }
  resolver {
    dns {
      hostname = "alloy-tail-sampling"
      port = 4317
    }
  }
}

otelcol.exporter.loadbalancing "span_metrics" {
  routing_key = "traceID"
  protocol { otlp { tls { insecure = true } } }
  resolver {
    dns {
      hostname = "alloy-span-metrics"
      port = 4317
    }
  }
}

otelcol.exporter.loadbalancing "grafana" {
  routing_key = "service"
  protocol { otlp { tls { insecure = true } } }
  resolver {
    dns {
      hostname = "alloy-grafana"
      port = 4317
    }
  }
}
