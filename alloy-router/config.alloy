otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
    max_recv_msg_size = "200MiB"
  }

  output {
    traces = [
      otelcol.exporter.otlp.tail_sampling.input,
      otelcol.exporter.otlp.span_metrics.input,
    ]
    logs = [otelcol.exporter.otlp.grafana.input]
  }
}

otelcol.exporter.otlp "tail_sampling" {
  client {
    endpoint = "alloy-tail-sampling:4317"
    tls {
      insecure = true
    }
  }
}

otelcol.exporter.otlp "span_metrics" {
  client {
    endpoint = "alloy-span-metrics:4317"
    tls {
      insecure = true
    }
  }
}

otelcol.exporter.otlp "grafana" {
  client {
    endpoint = "alloy-grafana:4317"
    tls {
      insecure = true
    }
  }
}
