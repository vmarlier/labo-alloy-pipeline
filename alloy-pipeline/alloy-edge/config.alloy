otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }

  output {
    metrics = [otelcol.exporter.otlphttp.victoriametrics.input]
    traces  = [otelcol.exporter.otlp.router.input]
    logs    = [otelcol.exporter.otlp.router.input]
  }
}

otelcol.exporter.otlphttp "victoriametrics" {
  client { endpoint = "http://victoriametrics:8428/opentelemetry" }
}

otelcol.exporter.otlp "router" {
  client {
    endpoint = "alloy-router:4317"
    tls { insecure = true }
  }
}
